{
  "name": "solana-wallet-intelligence",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "corepack pnpm@10.15.1 --parallel --filter @intelligence/api --filter @intelligence/worker --filter @intelligence/dashboard dev",
    "dev:api": "corepack pnpm@10.15.1 --filter @intelligence/api dev",
    "dev:dashboard": "corepack pnpm@10.15.1 --filter @intelligence/dashboard dev",
    "dev:worker": "corepack pnpm@10.15.1 --filter @intelligence/worker dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts --configLoader runner",
    "test:watch": "vitest --config vitest.config.ts --configLoader runner",
    "build": "corepack pnpm@10.15.1 --filter @intelligence/api build && corepack pnpm@10.15.1 --filter @intelligence/worker build && corepack pnpm@10.15.1 --filter @intelligence/dashboard build",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "db:check": "tsx scripts/validate-migrations.ts",
    "research:report": "tsx scripts/research-report.ts",
    "evidence:collect": "tsx scripts/evidence-collect.ts",
    "shadow:soak": "tsx scripts/shadow-soak.ts",
    "shadow:e2e": "tsx scripts/shadow-e2e.ts",
    "resources:check": "tsx scripts/resources-check.ts",
    "readiness:report": "tsx scripts/readiness-report.ts",
    "staging:durability": "tsx scripts/staging-verify.ts",
    "staging:verify": "tsx scripts/staging-verify.ts",
    "helius:validate": "tsx scripts/live-read-validation.ts",
    "provider:fallback:validate": "tsx scripts/provider-fallback-validation.ts",
    "secrets:generate": "tsx scripts/generate-secrets.ts",
    "maintenance:prune-raw": "tsx scripts/prune-raw-payloads.ts",
    "performance:validate": "tsx scripts/performance-validation.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/node": "24.3.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.34.0",
    "globals": "16.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.6"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.12",
      "postcss": "8.5.23",
      "sharp": "0.35.0"
    }
  }
}
