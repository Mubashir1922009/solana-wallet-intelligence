{
  "name": "solana-wallet-intelligence",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "corepack pnpm@10.15.1 --parallel --filter @intelligence/api --filter @intelligence/dashboard dev",
    "dev:api": "corepack pnpm@10.15.1 --filter @intelligence/api dev",
    "dev:dashboard": "corepack pnpm@10.15.1 --filter @intelligence/dashboard dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "corepack pnpm@10.15.1 --filter @intelligence/api build && corepack pnpm@10.15.1 --filter @intelligence/dashboard build",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "db:check": "tsx scripts/validate-migrations.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/node": "24.3.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.34.0",
    "globals": "16.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "sharp": "0.35.0"
    }
  }
}
